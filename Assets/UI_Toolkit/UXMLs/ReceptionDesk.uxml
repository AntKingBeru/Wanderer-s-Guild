<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI_Toolkit/USSs/ReceptionDesk.uss?fileID=7433441132597879392&amp;guid=6f56e4fb506f9454ead78f7f25247aa5&amp;type=3#ReceptionDesk"/>
    <ui:VisualElement name="reception-desk" class="screen reception-desk">
        <ui:VisualElement class="panel panel--left">
            <ui:Label text="Requests" class="panel__header"/>
            <ui:ScrollView name="request-list" class="request-list"/>
        </ui:VisualElement>
        <ui:VisualElement class="panel panel--center">
            <ui:Label text="Create Quest" class="panel__header"/>
            <ui:VisualElement name="builder-empty" class="builder-empty">
                <ui:Label text="Select a request from the left to begin." class="builder-empty__text"/>
            </ui:VisualElement>
            <ui:VisualElement name="builder-form" class="builder-form">
                <ui:Label name="builder-header" class="builder-form__title"/>
                <ui:VisualElement class="field">
                    <ui:VisualElement class="field__row">
                        <ui:Label text="Guild Reward Share" class="field__label"/>
                        <ui:Label name="guild-percent-value" text="30%" class="field__value"/>
                    </ui:VisualElement>
                    <ui:SliderInt name="guild-percent" high-value="100"/>
                </ui:VisualElement>
                <ui:VisualElement class="field field--row">
                    <ui:VisualElement class="field__half">
                        <ui:Label text="Min Rank" class="field__label"/>
                        <ui:DropdownField name="min-rank"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="field__half">
                        <ui:Label text="Max Rank" class="field__label"/>
                        <ui:DropdownField name="max-rank"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="field">
                    <ui:Label text="Min Party Size" class="field__label"/>
                    <ui:SliderInt name="min-party" low-value="1" high-value="7" show-input-field="true"/>
                </ui:VisualElement>
                <ui:VisualElement class="field">
                    <ui:Label text="Max Party Size" class="field__label"/>
                    <ui:SliderInt name="max-party" low-value="1" high-value="7" show-input-field="true"/>
                </ui:VisualElement>
                <ui:Label name="builder-error" class="builder-error"/>
                <ui:Button name="create-quest" text="Create Quest" class="create-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="panel panel--right">
            <ui:Label text="Applications" class="panel__header" />
            <ui:Label text="Applications appear here once adventurers are integrated."
                      class="placeholder-text" />
            <ui:VisualElement class="panel__spacer" />
            <ui:Button name="close-screen" text="Close" class="close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
