.billboard { align-items: center; }
.class-image {
    width: 128px; height: 128px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 4px;
}
.info-row { flex-direction: row; align-items: center; }
.info-label { color: rgb(238, 240, 245); font-size: 13px; -unity-font-style: bold; }
.rank-span { margin-left: 2px; }
.rank-label { font-size: 13px; -unity-font-style: bold; }
.hp-track {
    width: 72px; height: 6px; margin-top: 3px;
    background-color: rgba(0, 0, 0, 0.55); border-radius: 3px;
}
.hp-fill {
    height: 100%; width: 100%;
    background-color: rgb(80, 190, 90); border-radius: 3px;
}