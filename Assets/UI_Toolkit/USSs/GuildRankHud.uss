.rank-hud {
    position: absolute;
    bottom: 16px;
    left: 24px;
    right: 24px;
    height: 44px;
    flex-direction: row;
    align-items: center;
}

.rank-side {
    width: 52px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.rank-side--current { -unity-text-align: middle-right; margin-right: 14px; }
.rank-side--next { -unity-text-align: middle-left; margin-left: 14px; }

.rank-track {
    flex-grow: 1;
    height: 18px;
    border-radius: 9px;
    background-color: rgba(10, 12, 18, 0.85);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.rank-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(120, 120, 120);
    border-radius: 9px;
}