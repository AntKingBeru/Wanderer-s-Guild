.rep-hud {
    position: absolute;
    top: 64px;
    right: 0;
    width: 320px;
    height: 44px;
}

.rep-clip {
    position: absolute;
    right: 0; top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.rep-bar-container {
    position: absolute;
    right: 0; top: 6px;
    width: 300px;
    height: 32px;
    flex-direction: row;
    align-items: center;
    translate: 90% 0;
}

.rep-bar {
    width: 260px;
    height: 18px;
    border-radius: 9px;
    background-color: rgba(255,255,255,0.08);
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: rgba(0,0,0,0.4);
}

.rep-emoji {
    position: absolute;
    left: 50%;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    top: -6px;
    -unity-background-scale-mode: scale-to-fit;
}