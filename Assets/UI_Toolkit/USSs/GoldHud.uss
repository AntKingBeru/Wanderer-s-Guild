.gold-hud {
    position: absolute;
    top: 64px;
    left: 12px;
    flex-direction: row;
    align-items: center;
}
.gold-icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}
.gold-amount {
    color: rgb(240, 220, 130);
    font-size: 18px;
    -unity-font-style: bold;
}
.gold-floaters {
    position: absolute;
    left: 30px;
    top: 0;
    width: 90px;
    height: 24px;
}
.gold-floater {
    position: absolute;
    font-size: 14px;
    -unity-font-style: bold;
}
.gold-floater--gain { color: rgb(90, 200, 100); }
.gold-floater--loss { color: rgb(210, 90, 80); }