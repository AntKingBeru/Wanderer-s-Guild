<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:wg="WanderersGuild">
    <Style src="project://database/Assets/_Project/UI_Toolkit/USSs/WorldView.uss?fileID=7433441132597879392&amp;guid=98327eb0cf7704145994483b06881d8a&amp;type=3#WorldView"/>
    <!-- The world render texture, full canvas (same integer scale + letterbox as the UI). Never picks. -->
    <ui:VisualElement name="world-view" class="world-view" picking-mode="Ignore" />
    <!-- Speech bubbles (created in code), under the label and cards. Never picks. -->
    <ui:VisualElement name="world-bubbles" class="world-bubbles" picking-mode="Ignore" />

    <!-- Opening goal under the HUD bar (hidden once done). -->
    <wg:OutlinedText name="world-goal" class="world-goal" text="Build lodgings: 0/3" />

    <!-- Name of the hovered guild object, adventurer or bedroom, centred above it (positioned in code). -->
    <ui:VisualElement name="world-label" class="pixel-window world-label" picking-mode="Ignore">
        <wg:OutlinedText name="world-label-text" text="Reception Desk" />
    </ui:VisualElement>

    <!-- Floating adventurer card beside a clicked adventurer (positioned in code). Picks, so the world under it doesn't. -->
    <ui:VisualElement name="world-card" class="pixel-window world-card" picking-mode="Position">
        <ui:VisualElement class="world-card__header" picking-mode="Ignore">
            <wg:OutlinedText name="world-card-name" class="world-card__name" text="Bran" />
            <ui:Button name="world-card-close" class="pixel-button world-card__close"><wg:OutlinedText text="x" /></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="world-card__icon-row" picking-mode="Ignore">
            <ui:VisualElement name="world-card-class-icon" class="world-card__class-icon" />
            <wg:OutlinedText name="world-card-info" class="world-card__line world-card__line--fill" text="Elf · Archer · Lv 2 · Rank F" />
        </ui:VisualElement>
        <wg:OutlinedText name="world-card-status" class="world-card__line" text="Idle · Well fed (+6%)" />
        <wg:OutlinedText name="world-card-room" class="world-card__line" text="Room: Bedroom 2" />
        <wg:OutlinedText name="world-card-party" class="world-card__line" text="The Iron Wolves" />
        <ui:VisualElement class="world-card__buttons" picking-mode="Ignore">
            <ui:Button name="world-card-details" class="pixel-button world-card__button"><wg:OutlinedText text="Details" /></ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Floating room card above a clicked bedroom (positioned in code): beds + residents (lines created in code). -->
    <ui:VisualElement name="room-card" class="pixel-window world-card" picking-mode="Position">
        <ui:VisualElement class="world-card__header" picking-mode="Ignore">
            <wg:OutlinedText name="room-card-title" class="world-card__name" text="Bedroom 2 · Lv 1" />
            <ui:Button name="room-card-close" class="pixel-button world-card__close"><wg:OutlinedText text="x" /></ui:Button>
        </ui:VisualElement>
        <wg:OutlinedText name="room-card-beds" class="world-card__line" text="Beds 1/2" />
        <ui:VisualElement name="room-card-residents" class="room-card__residents" picking-mode="Ignore" />
        <wg:OutlinedText name="room-card-empty" class="world-card__line" text="No residents" />
    </ui:VisualElement>
</ui:UXML>