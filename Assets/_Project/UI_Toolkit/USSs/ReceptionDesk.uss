/* Reception desk in 320×180 UI pixels: Requests (left half) and Applications (right half), Close below. */
.desk-window {
    width: 250px;
}
/* NOTE: ~30px between the halves — the focus/hover scale pop grows each half into the gap, never over its neighbour. */
.desk-halves {
    flex-direction: row;
    justify-content: space-between;
    align-self: stretch;
    margin-top: 2px;
    padding: 0 4px;
}
/* NOTE: Each half is one button: title on top, detail line under it, both centred; it scales from its own centre. */
.desk-half {
    width: 100px;
    height: 60px;
    margin: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform-origin: center;
}
.desk-half__title {
    margin-bottom: 4px;
}
.desk-half__title .outlined-text__fill {
    color: var(--color-accent);
}
.desk-half__detail .outlined-text__fill {
    color: var(--color-text-disabled);
}
.desk-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-self: stretch;
    margin-top: 3px;
}