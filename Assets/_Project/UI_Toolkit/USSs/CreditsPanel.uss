.credits-window {
    width: 200px;
    height: 150px;
}
/* NOTE: Zero basis plus grow: the list fills only the space left after the title and Back button,
   instead of starting at its full content height and forcing its siblings to shrink. */
.credits-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    align-self: stretch;
    margin: 2px 0 6px 0;
}
.credits-scroll .unity-scroll-view__content-container {
    align-items: center;
}
.credits-heading {
    margin-top: 2px;
}
.credits-heading .outlined-text__fill {
    color: var(--color-accent);
}
.credits-spacer {
    height: 8px;
}