/* Start-tutorial prompt (28a). The instruction box and highlights join this sheet in 28b. */
.tutorial-prompt {
    width: 240px;
}
.tutorial-prompt__title {
    margin: 2px 0 4px 0;
    align-self: center;
}
.tutorial-prompt__body {
    margin: 0 0 6px 0;
    align-self: center;
}
.tutorial-prompt__buttons {
    flex-direction: row;
    justify-content: center;
}
/* ---------- Guided tutorial overlay ---------- */
.tutorial-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
.tutorial-blocker {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
.tutorial-dim {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.35);
    display: none;
}
.tutorial-frame {
    position: absolute;
    border-width: 1px;
    border-color: var(--color-accent);
    display: none;
}
.tutorial-frame.tutorial-frame--off {
    border-color: rgba(0, 0, 0, 0);
}
/* NOTE: Two classes, so these beat the theme's .pixel-window / .panel-button. */
.pixel-window.tutorial-box {
    position: absolute;
    width: 160px;
    padding: 4px 5px;
    align-items: stretch;
    display: none;
}
.tutorial-text {
    align-self: stretch;
}
.tutorial-text .outlined-text__stack {
    align-self: stretch;
}
.tutorial-text .outlined-text__part {
    white-space: normal;
    -unity-text-align: upper-left;
}
.panel-button.tutorial-next {
    align-self: flex-end;
    margin: 3px 0 0 0;
}
/* ---------- Room guide popup ---------- */
.guide-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
}
.pixel-window.guide-card {
    margin-top: 36px;
    width: 170px;
    padding: 4px 5px;
    align-items: stretch;
    display: none;
}
.guide-title {
    margin-bottom: 2px;
}
.guide-title .outlined-text__fill {
    color: var(--color-accent);
}
.guide-body {
    align-self: stretch;
}
.guide-body .outlined-text__stack {
    align-self: stretch;
}
.guide-body .outlined-text__part {
    white-space: normal;
    -unity-text-align: upper-left;
}
.panel-button.guide-ok {
    align-self: flex-end;
    margin: 3px 0 0 0;
}