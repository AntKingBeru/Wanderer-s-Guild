/* Armory screen in 320×180 UI pixels: items for sale (left) + the selected item (right), restock info in the footer. */
.arm-window {
    width: 300px;
    height: 164px;
}
/* NOTE: The theme's pixel-window centres its children — body and footer stretch to the window's width. */
.arm-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-self: stretch;
}

/* ---------- List ---------- */
.arm-list-frame {
    width: 140px;
    margin-right: 4px;
}
.arm-list {
    flex-grow: 1;
}
.arm-list-empty {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}
.arm-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    height: 22px;
    margin: 0 0 1px 0;
    padding: 0 2px;
}
.arm-row--selected {
    border-color: var(--color-accent);
}
/* NOTE: Clipped text containers use 2px left/right padding (the outline reaches 1.5px past each glyph). */
.arm-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    padding: 1px 2px;
}
.arm-row__info .outlined-text__fill {
    color: var(--color-text-disabled);
}
.arm-row__units {
    flex-shrink: 0;
    margin-left: 2px;
}
.arm-row--soldout .arm-row__units .outlined-text__fill {
    color: rgb(224, 112, 96);
}

/* ---------- Details ---------- */
.arm-details {
    flex-grow: 1;
    min-width: 0;
}
.arm-content {
    flex-grow: 1;
    min-height: 0;
}
.arm-content .unity-scroll-view__content-container {
    padding: 1px 2px;
}
.arm-name {
    margin-bottom: 1px;
}
.arm-name .outlined-text__fill {
    color: var(--color-accent);
}
.arm-line .outlined-text__fill {
    color: var(--color-text-disabled);
}
.arm-gap {
    margin-top: 2px;
}
.arm-stats {
    margin-top: 1px;
}
.arm-wrap {
    align-items: stretch;
}
.arm-wrap .outlined-text__stack {
    align-self: stretch;
}
.arm-wrap .outlined-text__part {
    white-space: normal;
}
.arm-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    display: none;
}

/* ---------- Footer ---------- */
.arm-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
    flex-shrink: 0;
    margin-top: 3px;
}
.arm-footer-text {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    padding: 1px 2px;
}
.arm-footer-text .outlined-text__fill {
    color: var(--color-text-disabled);
}
.arm-name-row {
    flex-direction: row;
    align-items: center;
}
.arm-icon {
    margin-right: 2px;
}
.arm-row__icon {
    margin-right: 2px;
}