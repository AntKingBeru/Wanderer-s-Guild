/* Adventurer roster in 320×180 UI pixels: list (left) + scrolling details (right), Promote pinned under the details. */
.roster-window {
    width: 300px;
    height: 164px;
}
.roster-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-self: stretch;
}

/* ---------- List ---------- */
.roster-list-frame {
    width: 150px;
    margin-right: 4px;
}
.roster-list {
    flex-grow: 1;
}
.roster-list-empty {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}
.roster-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    height: 14px;
    margin: 0 0 1px 0;
    padding: 0 2px 0 1px;
}
.roster-row--selected {
    border-color: var(--color-accent);
}

/* Rank badge: same 12×12 square as the HUD and request-board badges. */
.roster-row__badge {
    width: 12px;
    height: 12px;
    margin-right: 3px;
    border-width: 1px;
    border-color: var(--color-outline);
}
.roster-row__badge > .outlined-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.roster-row__badge .outlined-text__stack {
    flex-grow: 1;
}
.roster-row__badge .outlined-text__part {
    flex-grow: 1;
    -unity-text-align: middle-center;
}

/* NOTE: The selected row's name slides when it's too long (MarqueeLine): one unwrapped line whose text block keeps its own
   width — the same rules as BuildMode.uss's .marquee (that sheet isn't loaded by the Roster document). */
.roster-row__name {
    align-items: flex-start;
}
.roster-row__name .outlined-text__stack {
    align-self: flex-start;
    flex-shrink: 0;
}
.roster-row__name .outlined-text__part {
    white-space: nowrap;
}
.roster-row__class {
    width: 44px;
    overflow: hidden;
    padding: 1px 2px;
}
.roster-row__class .outlined-text__fill {
    color: var(--color-text-disabled);
}
.roster-row__level {
    width: 26px;
    align-items: flex-end;
}

/* ---------- Details (one scroll view) ---------- */
.roster-details {
    flex-grow: 1;
    min-width: 0;
}
/* NOTE: The whole pane scrolls; the content keeps the viewport's width (no horizontal scroll), so long lines wrap. The
   content's 1px/2px padding keeps every glyph's outline inside the scroll's clip. */
.adv-content {
    flex-grow: 1;
    min-height: 0;
}
.adv-content .unity-scroll-view__content-container {
    padding: 1px 2px;
}
.adv-name {
    margin-bottom: 1px;
}
.adv-name .outlined-text__fill {
    color: var(--color-accent);
}
.adv-line .outlined-text__fill,
.adv-hint .outlined-text__fill {
    color: var(--color-text-disabled);
}
.adv-gap {
    margin-top: 2px;
}

/* XP and rank-progress bars: track + fill (fill width set in code, whole UI pixels) + text. */
.adv-bar {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}
.adv-bar-track {
    width: 50px;
    height: 6px;
    margin-right: 4px;
    border-width: 1px;
    border-color: var(--frame-normal-border);
    background-color: var(--frame-disabled-bg);
}
.adv-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--color-accent);
}
.adv-bar-fill--rank {
    background-color: rgb(120, 200, 120);
}
.adv-stats {
    margin-top: 2px;
}
/* NOTE: Long lines (affinities, gear, the promotion hint) wrap inside the scroll view. */
.adv-wrap {
    align-items: stretch;
}
.adv-wrap .outlined-text__stack {
    align-self: stretch;
}
.adv-wrap .outlined-text__part {
    white-space: normal;
}
.adv-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    display: none;
}
.adv-buttons {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: 1px;
}

/* ---------- Footer ---------- */
.roster-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-self: stretch;
    flex-shrink: 0;
    margin-top: 3px;
}
/* ---------- Class chooser (Advance) ---------- */
/* NOTE: Display is set in code (none until opened); it dims the roster like the confirm overlay. */
.chooser-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--color-dim);
    align-items: center;
    justify-content: center;
    display: none;
}
.chooser-window {
    width: 200px;
    align-items: stretch;
}
.chooser-title {
    align-self: center;
    margin-bottom: 3px;
}
.chooser-title .outlined-text__fill {
    color: var(--color-accent);
}
.chooser-options {
    align-items: stretch;
    margin-bottom: 3px;
}
.pixel-button.chooser-option {
    margin: 0 0 2px 0;
    padding: 1px 4px;
    align-items: flex-start;
}
.adv-icon-row {
    flex-direction: row;
    align-items: center;
}
.adv-class-icon {
    margin-right: 2px;
}
/* NOTE: Class icon (12) + gap (2) left of the class name; the name column absorbs the difference. */
.roster-row__class-icon {
    margin-right: 2px;
}
/* NOTE: Only the name column shrinks (it clips); the badge, class and level keep their widths, and the level never wraps. */
.roster-row__badge,
.roster-row__class,
.roster-row__level {
    flex-shrink: 0;
}
.roster-row__level .outlined-text__part {
    white-space: nowrap;
}