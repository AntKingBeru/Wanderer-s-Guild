/* Build mode in 320×180 UI pixels: catalog bar along the bottom, a label beside the cursor, confirm overlay. */
.build-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---------- Cursor label ---------- */
.build-cursor {
    position: absolute;
    padding: 1px 4px;
    display: none;
}
.build-cursor--invalid .outlined-text__fill {
    color: rgb(224, 112, 96);
}

/* ---------- Bottom bar ---------- */
/* NOTE: Flush with the bottom edge (only the top border shows). The HUD hides its rank bar and reputation while building. */
.build-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 46px;
    padding: 2px 4px;
    margin: 0;
    flex-direction: column;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
/* NOTE: The theme's pixel-window centres its children (align-items: center), which sizes them to their content — the header
   and the catalog must stretch to the bar's width instead. */
.build-bar__header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    flex-shrink: 0;
}
/* NOTE: A fixed gap after the title; the hint takes the rest of the row, right-aligned, clipped if a narrow window squeezes it
   (1px padding keeps glyph outlines inside the clip). */
.build-title {
    flex-shrink: 0;
    margin-right: 8px;
}
.build-title .outlined-text__fill {
    color: var(--color-accent);
}
.build-hint {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    padding: 1px;
    align-items: flex-end;
}
.build-hint .outlined-text__fill {
    color: var(--color-text-disabled);
}

/* ---------- Catalog: clipped viewport + strip ---------- */
/* NOTE: The viewport stretches to the bar's width and is capped there (never sized by its cards), has an explicit height,
   and clips. The strip stays in-flow and never shrinks; its width is set in code to the cards' total and it's moved
   sideways in code. */
.build-catalog {
    flex-direction: row;
    flex-shrink: 0;
    align-self: stretch;
    max-width: 100%;
    height: 30px;
    margin-top: 2px;
    overflow: hidden;
}
.build-strip {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    align-items: center;
    align-self: stretch;
}

/* ---------- Cards ---------- */
.build-card {
    flex-direction: row;
    align-items: center;
    width: 86px;
    height: 28px;
    margin: 0 2px 0 0;
    padding: 1px 2px;
    flex-shrink: 0;
}
.pixel-button.build-card:hover {
    border-color: var(--frame-highlight-border);
}
.build-card--selected {
    border-color: var(--color-accent);
    background-color: var(--frame-highlight-bg);
}
.build-card__icon {
    width: 12px;
    height: 12px;
    margin-right: 2px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
/* NOTE: Lines are clipped at the card's edge; the 1px padding keeps glyph outlines inside the clip. */
.build-card__text {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    padding: 1px;
}
.build-card__info .outlined-text__fill,
.build-card__reason .outlined-text__fill {
    color: var(--color-text-disabled);
}
.build-card--poor .build-card__info .outlined-text__fill {
    color: rgb(224, 112, 96);
}